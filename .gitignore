# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.DS_Store

# Cached market data — regenerate with `python run_pipeline.py --no-cache`.
# Kept out of git so the repo stays small and the data stays reproducible
# from source rather than from a stale snapshot.
data/cache/*.csv

# Generated reports and charts are committed on purpose (see README) --
# they are the published record. Only scratch output is ignored here.
reports/output/*.tmp

# Built website. Cloudflare Pages runs `python site/build.py` itself, so the
# output is regenerated on every deploy and does not belong in git.
site/dist/

# Local upload artefacts
*.zip

# The score archive is a queryable log, rebuildable from the published JSON.
# Committing a binary that changes every week would bloat the history; the
# published reports remain the record of what was said and when.
data/archive.db

# Pro (members-only) report artefacts. This repository is PUBLIC — committing
# these would publish the paid tier to anyone who opens GitHub, which defeats
# the gate entirely. They are generated locally and deployed to a members-only
# path, never through the repo.
reports/output/*_pro.json
reports/output/*_pro_scores.csv

# Local Cloudflare dev state: compiled Function bundles, the miniflare KV
# emulator, caches. Regenerated by `wrangler pages dev` on every run.
.wrangler/
